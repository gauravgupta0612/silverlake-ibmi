    },
    "keybindings": [
      {
        "command": "silverlake.compile",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && silverlake.connected && editorLangId != sql"
      },
      {
        "command": "silverlake.runSql",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && silverlake.connected && editorLangId == sql"
      },
      {
        "command": "silverlake.runCl",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "silverlake.connected"
      },
      {
        "command": "silverlake.showMenu",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "silverlake.searchObjects",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "silverlake.connected"
      },
      {
        "command": "silverlake.searchSource",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "silverlake.connected"
      },
      {
        "command": "silverlake.prompt",
        "key": "f4",
        "when": "editorTextFocus && editorLangId =~ /^(rpgle|dds|cl)$/"
      },
      {
        "command": "silverlake.toggleSourceDates",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "resourceScheme == silverlake-member"
      }
    ],
    "languages": [
      {
        "id": "rpgle",
        "aliases": [
          "RPGLE",
          "ILE RPG",
          "rpgle"
        ],
        "extensions": [
          ".rpgle",
          ".sqlrpgle",
          ".rpgleinc",
          ".rpginc",
          ".rpg"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cl",
        "aliases": [
          "CL",
          "Control Language"
        ],
        "extensions": [
          ".clle",
          ".clp",
          ".cl",
          ".cmd"
        ],
        "configuration": "./language-configuration-cl.json"
      },
      {
        "id": "dds",
        "aliases": [
          "DDS"
        ],
        "extensions": [
          ".pf",
          ".lf",
          ".dspf",
          ".prtf"
        ],
        "configuration": "./language-configuration-dds.json"
      }
    ],
    "grammars": [
      {
        "language": "rpgle",
        "scopeName": "source.rpgle",
        "path": "./syntaxes/rpgle.tmLanguage.json"
      },
      {
        "language": "cl",
        "scopeName": "source.cl",
        "path": "./syntaxes/cl.tmLanguage.json"
      },
      {
        "language": "dds",
        "scopeName": "source.dds",
        "path": "./syntaxes/dds.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rpgle",
        "path": "./snippets/rpgle.json"
      },
      {
        "language": "cl",
        "path": "./snippets/cl.json"
      },
      {
        "language": "sql",
        "path": "./snippets/sql.json"
      }
    ],
    "configuration": {
      "title": "Silverlake for IBM i",
      "properties": {
        "silverlake.compileActions": {
          "type": "array",
          "markdownDescription": "Compile actions. Variables: `&LIB` (source library), `&OBJLIB` (target library), `&SRCFILE`, `&NAME`, `&EXT`, `&FULLPATH` (IFS path), `&CURLIB`, `&USER`. Add `OPTION(*EVENTF)` to get inline errors.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command",
              "extensions"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string",
                "enum": [
                  "member",
                  "ifs",
                  "both"
                ],
                "default": "member"
              }
            }
          },
          "default": [
            {
              "name": "Create Bound RPG Program (CRTBNDRPG)",
              "extensions": [
                "rpgle"
              ],
              "source": "member",
              "command": "CRTBNDRPG PGM(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF) DBGVIEW(*SOURCE) REPLACE(*YES)"
            },
            {
              "name": "Create RPG Module (CRTRPGMOD)",
              "extensions": [
                "rpgle"
              ],
              "source": "member",
              "command": "CRTRPGMOD MODULE(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF) DBGVIEW(*SOURCE) REPLACE(*YES)"
            },
            {
              "name": "Create SQL RPG Program (CRTSQLRPGI)",
              "extensions": [
                "sqlrpgle"
              ],
              "source": "member",
              "command": "CRTSQLRPGI OBJ(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OBJTYPE(*PGM) COMMIT(*NONE) OPTION(*EVENTF) DBGVIEW(*SOURCE) CLOSQLCSR(*ENDMOD) REPLACE(*YES)"
            },
            {
              "name": "Create Bound CL Program (CRTBNDCL)",
              "extensions": [
                "clle"
              ],
              "source": "member",
              "command": "CRTBNDCL PGM(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF) DBGVIEW(*SOURCE) REPLACE(*YES)"
            },
            {
              "name": "Create CL Program (CRTCLPGM)",
              "extensions": [
                "clp"
              ],
              "source": "member",
              "command": "CRTCLPGM PGM(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF) REPLACE(*YES)"
            },
            {
              "name": "Create Command (CRTCMD)",
              "extensions": [
                "cmd"
              ],
              "source": "member",
              "command": "CRTCMD CMD(&OBJLIB/&NAME) PGM(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF) REPLACE(*YES)"
            },
            {
              "name": "Create Physical File (CRTPF)",
              "extensions": [
                "pf"
              ],
              "source": "member",
              "command": "CRTPF FILE(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF)"
            },
            {
              "name": "Create Logical File (CRTLF)",
              "extensions": [
                "lf"
              ],
              "source": "member",
              "command": "CRTLF FILE(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF)"
            },
            {
              "name": "Create Display File (CRTDSPF)",
              "extensions": [
                "dspf"
              ],
              "source": "member",
              "command": "CRTDSPF FILE(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF) REPLACE(*YES)"
            },
            {
              "name": "Create Printer File (CRTPRTF)",
              "extensions": [
                "prtf"
              ],
              "source": "member",
              "command": "CRTPRTF FILE(&OBJLIB/&NAME) SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) OPTION(*EVENTF) REPLACE(*YES)"
            },
            {
              "name": "Run SQL Script (RUNSQLSTM)",
              "extensions": [
                "sql"
              ],
              "source": "member",
              "command": "RUNSQLSTM SRCFILE(&LIB/&SRCFILE) SRCMBR(&NAME) COMMIT(*NONE) NAMING(*SQL)"
            },
            {
              "name": "Create Bound RPG Program from IFS (CRTBNDRPG)",
              "extensions": [
                "rpgle"
              ],
              "source": "ifs",
              "command": "CRTBNDRPG PGM(&OBJLIB/&NAME) SRCSTMF('&FULLPATH') OPTION(*EVENTF) DBGVIEW(*SOURCE) REPLACE(*YES) TGTCCSID(*JOB)"
            },
            {
              "name": "Create SQL RPG Program from IFS (CRTSQLRPGI)",
              "extensions": [
                "sqlrpgle"
              ],
              "source": "ifs",
              "command": "CRTSQLRPGI OBJ(&OBJLIB/&NAME) SRCSTMF('&FULLPATH') OBJTYPE(*PGM) COMMIT(*NONE) OPTION(*EVENTF) DBGVIEW(*SOURCE) CVTCCSID(*JOB) REPLACE(*YES)"
            },
            {
              "name": "Create Bound CL Program from IFS (CRTBNDCL)",
              "extensions": [
                "clle"
              ],
              "source": "ifs",
              "command": "CRTBNDCL PGM(&OBJLIB/&NAME) SRCSTMF('&FULLPATH') OPTION(*EVENTF) DBGVIEW(*SOURCE) REPLACE(*YES)"
            },
            {
              "name": "Run SQL Script from IFS (RUNSQLSTM)",
              "extensions": [
                "sql"
              ],
              "source": "ifs",
              "command": "RUNSQLSTM SRCSTMF('&FULLPATH') COMMIT(*NONE) NAMING(*SQL)"
            }
          ]
        },
        "silverlake.sql.maxRows": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Maximum number of rows fetched into the SQL result grid."
        },
        "silverlake.sql.confirmDestructive": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before running DELETE, DROP, TRUNCATE or UPDATE without WHERE."
        },
        "silverlake.tempDirectory": {
          "type": "string",
          "default": "/tmp",
          "description": "IFS directory used for temporary files during member transfer."
        },
        "silverlake.spool.maxEntries": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of spooled files listed."
        },
        "silverlake.autoConnectLast": {
          "type": "boolean",
          "default": false,
          "description": "Reconnect automatically to the last used system when VS Code starts."
        },
        "silverlake.objects.showAll": {
          "type": "boolean",
          "default": true,
          "description": "Show an 'Objects' folder (programs, files, service programs\u2026) under each library."
        },
        "silverlake.dashboard.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "How often the System Dashboard refreshes (seconds). 0 = only when you click Refresh."
        },
        "silverlake.dataEditor.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 2000,
          "description": "Rows per page in the table data editor."
        },
        "silverlake.history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Keep a local copy of every member and IFS file you open or save, so you can compare and restore."
        },
        "silverlake.history.maxVersions": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Local history versions kept per member / file."
        },
        "silverlake.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check RPG sources as you type."
        },
        "silverlake.lint.maxProcedureLines": {
          "type": "number",
          "default": 200,
          "description": "Report procedures longer than this many lines."
        },
        "silverlake.lint.rules": {
          "type": "object",
          "markdownDescription": "Turn individual RPG checks on or off.",
          "default": {},
          "properties": {
            "unused-definition": {
              "type": "boolean",
              "default": true,
              "description": "Variables, constants and subroutines that are declared but never used"
            },
            "goto": {
              "type": "boolean",
              "default": true,
              "description": "GOTO usage"
            },
            "tag": {
              "type": "boolean",
              "default": true,
              "description": "TAG labels"
            },
            "program-end": {
              "type": "boolean",
              "default": true,
              "description": "Main program without *INLR = *ON or RETURN"
            },
            "long-procedure": {
              "type": "boolean",
              "default": true,
              "description": "Procedures longer than the configured number of lines"
            },
            "numbered-indicator": {
              "type": "boolean",
              "default": true,
              "description": "Numbered indicators (*IN01-*IN99)"
            },
            "empty-on-error": {
              "type": "boolean",
              "default": true,
              "description": "ON-ERROR blocks that silently swallow errors"
            },
            "select-star": {
              "type": "boolean",
              "default": true,
              "description": "SELECT * in embedded SQL"
            },
            "mixed-format": {
              "type": "boolean",
              "default": true,
              "description": "Fixed-format calculation specs in a free-format source"
            }
          },
          "additionalProperties": false
        },
        "silverlake.sourceDates.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Read and save members **with** their sequence numbers and change dates (SRCSEQ/SRCDAT), like SEU. Unchanged lines keep their date; changed lines get today's date. Needs a Mapepire SQL engine; otherwise members are copied as plain text."
        },
        "silverlake.sourceDates.display": {
          "type": "string",
          "enum": [
            "date",
            "seq-date",
            "off"
          ],
          "enumDescriptions": [
            "Show the change date in front of each line",
            "Show sequence number and change date",
            "Hide"
          ],
          "default": "date",
          "description": "What to show in front of each member line (Ctrl+Alt+D cycles)."
        },
        "silverlake.sourceDates.format": {
          "type": "string",
          "enum": [
            "yymmdd",
            "iso"
          ],
          "default": "yymmdd",
          "description": "Date format: SEU-style YYMMDD or ISO YYYY-MM-DD."
        },
        "silverlake.conflictCheck": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a member is locked by another job, or changed on the IBM i after you opened it, before your save overwrites it."
        },
        "silverlake.members.sortBy": {
          "type": "string",
          "enum": [
            "name",
            "date"
          ],
          "default": "name",
          "description": "Order of members in the Libraries view."
        }
      }
    }
  },
