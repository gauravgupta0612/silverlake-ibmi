{
  "name": "silverlake-ibmi",
  "displayName": "Silverlake for IBM i",
  "description": "A friendly, all-in-one IBM i workbench for VS Code: connection wizard, library & IFS browser, edit and compile with inline errors, Db2 for i SQL with autocomplete, table data editor, system dashboard, jobs & messages, object and source search, RPG navigation and code checks, local history.",
  "version": "0.3.0",
  "publisher": "gauravgupta0612",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "IBM i",
    "AS400",
    "iSeries",
    "RPG",
    "RPGLE",
    "CL",
    "Db2 for i",
    "Mapepire"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:silverlake-member",
    "onFileSystem:silverlake-ifs",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "silverlake",
          "title": "Silverlake for IBM i",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "silverlake": [
        {
          "id": "silverlake.connections",
          "name": "Connections"
        },
        {
          "id": "silverlake.libraries",
          "name": "Libraries & Source",
          "when": "silverlake.connected"
        },
        {
          "id": "silverlake.ifs",
          "name": "IFS Browser",
          "when": "silverlake.connected"
        },
        {
          "id": "silverlake.spool",
          "name": "My Spooled Files",
          "when": "silverlake.connected"
        },
        {
          "id": "silverlake.jobs",
          "name": "Active Jobs",
          "when": "silverlake.connected",
          "visibility": "collapsed"
        },
        {
          "id": "silverlake.messages",
          "name": "Messages",
          "when": "silverlake.connected",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "silverlake.connections",
        "contents": "No IBM i systems yet. Add one in a few seconds with the guided form.\n[$(add) Add IBM i Connection](command:silverlake.addConnection)\n[Open the Getting Started guide](command:silverlake.openWalkthrough)"
      },
      {
        "view": "silverlake.libraries",
        "contents": "Your library list is empty.\n[$(add) Add Library](command:silverlake.addLibrary)"
      }
    ],
    "walkthroughs": [
      {
        "id": "silverlake.gettingStarted",
        "title": "Get started with Silverlake for IBM i",
        "description": "Connect to your IBM i, browse source, compile and run SQL.",
        "steps": [
          {
            "id": "connect",
            "title": "Add your IBM i connection",
            "description": "Use the guided form to enter host, user and library list. Passwords are stored in the VS Code secret store.\n[Add Connection](command:silverlake.addConnection)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            }
          },
          {
            "id": "browse",
            "title": "Browse libraries and open members",
            "description": "Open the Silverlake view, expand a library, then a source file, and click a member to edit it like a local file.",
            "media": {
              "markdown": "media/walkthrough/browse.md"
            }
          },
          {
            "id": "compile",
            "title": "Compile with one key",
            "description": "Press Ctrl+Alt+C (Cmd+Alt+C on Mac) in a member. Errors appear inline and in the Problems panel.",
            "media": {
              "markdown": "media/walkthrough/compile.md"
            }
          },
          {
            "id": "sql",
            "title": "Run SQL",
            "description": "Open an SQL scratchpad and press Ctrl+Enter to run the statement under the cursor. Results open in a filterable grid you can export to CSV.\n[Open SQL Scratchpad](command:silverlake.newSqlScratchpad)",
            "media": {
              "markdown": "media/walkthrough/sql.md"
            }
          },
          {
            "id": "more",
            "title": "Monitor and explore your system",
            "description": "Open the System Dashboard, check active jobs and answer QSYSOPR messages, search objects (Ctrl+Alt+O) or source code (Ctrl+Alt+F), and edit table data in a grid.\n[Open System Dashboard](command:silverlake.openDashboard)",
            "media": {
              "markdown": "media/walkthrough/more.md"
            }
          }
        ]
      }
    ],
