        {
          "command": "silverlake.compareWithServer",
          "when": "silverlake.connected && resourceScheme =~ /^silverlake-(member|ifs)$/",
          "group": "1_silverlake@1"
        },
        {
          "command": "silverlake.showHistory",
          "when": "resourceScheme =~ /^silverlake-(member|ifs)$/",
          "group": "1_silverlake@2"
        },
        {
          "command": "silverlake.toggleSourceDates",
          "when": "resourceScheme == silverlake-member",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "silverlake.runSql",
          "when": "silverlake.connected && editorLangId == sql",
          "group": "silverlake@1"
        },
        {
          "command": "silverlake.convertToFree",
          "when": "editorLangId == rpgle && editorHasSelection",
          "group": "silverlake@2"
        },
        {
          "command": "silverlake.compareWithServer",
          "when": "silverlake.connected && resourceScheme =~ /^silverlake-(member|ifs)$/",
          "group": "silverlake@3"
        },
        {
          "command": "silverlake.compareMembers",
          "when": "silverlake.connected && resourceScheme =~ /^silverlake-(member|ifs)$/",
          "group": "silverlake@4"
        },
        {
          "command": "silverlake.showHistory",
          "when": "resourceScheme =~ /^silverlake-(member|ifs)$/",
          "group": "silverlake@5"
        },
        {
          "command": "silverlake.prompt",
          "when": "editorLangId =~ /^(rpgle|dds|cl)$/",
          "group": "silverlake@0"
        },
        {
          "command": "silverlake.changedSince",
          "when": "resourceScheme == silverlake-member",
          "group": "silverlake@6"
        },
        {
          "command": "silverlake.lockActions",
          "when": "resourceScheme == silverlake-member",
          "group": "silverlake@7"
        }
      ],
      "commandPalette": [
        {
          "command": "silverlake.connect",
          "when": "false"
        },
        {
          "command": "silverlake.removeLibrary",
          "when": "false"
        },
        {
          "command": "silverlake.setCurrentLibrary",
          "when": "false"
        },
        {
